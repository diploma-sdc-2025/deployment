# Copy to /etc/nginx/sites-available/autochess-front and symlink to sites-enabled.
# If nginx fails because /etc/letsencrypt/... is missing, start with
# front-dev-bootstrap.conf.example (HTTP only), run certbot, then use this file or let certbot manage SSL.
# Replace YOUR_DOMAIN with a DNS name pointing at this VM (Let's Encrypt needs a hostname, not only an IP).
#
# Vite must listen on localhost only so nginx owns 443:
#   npm run dev -- --host 127.0.0.1 --port 3000
#
# Issue certificates (after DNS points here):
#   sudo apt install -y nginx certbot python3-certbot-nginx
#   sudo certbot --nginx -d YOUR_DOMAIN
#
# Open Azure NSG: allow inbound TCP 80 and 443 from the internet (certbot HTTP-01 uses 80).

upstream vite_dev {
    server 127.0.0.1:3000;
}

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN;

    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    location / {
        proxy_pass http://vite_dev;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}
