# Copy to `.env` in this folder. Docker Compose reads it automatically.

# --- JWT (required) ---
AUTH_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Option A: Azure PostgreSQL (docker-compose.yml only) ---
# DB_SERVER = hostname *without* `.postgres.database.azure.com`
# Example: if your server is `myproj-db.postgres.database.azure.com`, set:
#   DB_SERVER=myproj-db
# Do NOT use placeholder names like `autochess-db-server` unless that server exists.
# DB_SERVER=your-real-server-name
# DB_PORT=5432
# DB_USERNAME=...
# DB_PASSWORD=...

# --- Option B: Local Postgres (use with docker-compose.local.yml) ---
# Match database names to docker/init-databases.sql (auth, matchmaking, game, battle, analytics).
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
# Ignored when SPRING_DATASOURCE_URL is set (local compose), but keep for Flyway placeholders.
DB_SERVER=localhost

AUTH_DB_NAME=auth
MATCHMAKING_DB_NAME=matchmaking
GAME_DB_NAME=game
BATTLE_DB_NAME=battle
ANALYTICS_DB_NAME=analytics

# Flyway-created app users (per service; use strong passwords in real deploys)
AUTH_APP_USER=auth_app
AUTH_APP_PASSWORD=auth_app_pass
MATCHMAKING_APP_USER=mm_app
MATCHMAKING_APP_PASSWORD=mm_app_pass
GAME_APP_USER=game_app
GAME_APP_PASSWORD=game_app_pass
BATTLE_APP_USER=battle_app
BATTLE_APP_PASSWORD=battle_app_pass
ANALYTICS_APP_USER=analytics_app
ANALYTICS_APP_PASSWORD=analytics_app_pass
